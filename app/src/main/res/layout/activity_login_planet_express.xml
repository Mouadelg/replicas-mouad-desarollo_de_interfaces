<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/planet_green">

    <ImageView
        android:id="@+id/ockLogo"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:src="@drawable/ocklogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Ock Logo"
        />

        <EditText
            android:id="@+id/label_email"
            android:layout_width="400dp"
            android:layout_height="60dp"
            app:layout_constraintTop_toBottomOf="@id/ockLogo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:drawableStart="@drawable/email_icon"
            android:drawablePadding="12dp"
            android:background="@drawable/rounded_input"
            android:padding="10dp"
            android:paddingStart="30dp"
            android:textColor="@color/black"
/>
    <EditText
        android:layout_marginTop="25dp"
        android:id="@+id/label_password"
        android:layout_width="400dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toBottomOf="@id/label_email"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:hint="Password"
        android:inputType="textEmailAddress"
        android:drawableStart="@drawable/lock_icon"
        android:drawablePadding="12dp"
        android:background="@drawable/rounded_input"
        android:padding="10dp"
        android:paddingStart="30dp"
        android:textColor="@color/black"
        />

    <ImageView
        android:id="@+id/buton_iniciar_sesion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="292dp"
        android:layout_height="123dp"
        android:layout_marginTop="25dp"
        android:src="@drawable/boton_iniciar_sesion"
        app:layout_constraintTop_toBottomOf="@id/label_password"
        tools:layout_editor_absoluteX="251dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿No tienes cuenta? REGÍSTRATE"
        app:layout_constraintTop_toBottomOf="@id/buton_iniciar_sesion"
        android:textColor="@color/planet_green_light"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

